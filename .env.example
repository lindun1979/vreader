# vreader 配置样例。复制为 .env（0600），填真实值。.env 不进仓。

# HTTP 服务
VREADER_HOST=127.0.0.1
VREADER_PORT=8232

# skill_router ↔ vreader 之间的 HMAC 共享密钥（与 life-assistant 侧一致）
VREADER_HMAC_SECRET=change-me

# 飞书（复用 life-assistant 的 app 凭据；REST 发送用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 提取用 claude CLI 路径（生产环境写绝对路径，见 DEPLOY.local.md）
CLAUDE_BIN=claude

# 管理员飞书 open_id（仅此人可 /confirm 待确认记录入榜）
VREADER_ADMIN_SENDER_ID=

# 数据根目录（默认 ./data）
VREADER_DATA_DIR=

# 提取 LLM 后端：openai（默认，:8317 cliproxy）| claude
LLM_BACKEND=openai
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=
# 主模型 + 兜底链（逗号分隔）。实测 gemini-2.5-flash 准确率最高但 40 rpd，
# gemini-3.1-flash-lite 快且 1000 rpd 作兜底。
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_FALLBACK=gemini-3.1-flash-lite
LLM_TIMEOUT=600
