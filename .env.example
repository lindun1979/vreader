# vreader 配置样例。复制为 .env（0600），填真实值。.env 不进仓。

# HTTP 服务
VREADER_HOST=127.0.0.1
VREADER_PORT=8232

# skill_router ↔ vreader 之间的 HMAC 共享密钥（与 life-assistant 侧一致）
VREADER_HMAC_SECRET=change-me

# 飞书（复用 life-assistant 的 app 凭据；REST 发送用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 提取用 claude CLI 路径（生产环境写绝对路径，见 DEPLOY.local.md）
CLAUDE_BIN=claude

# 管理员飞书 open_id（仅此人可 /confirm 待确认记录入榜）
VREADER_ADMIN_SENDER_ID=

# 数据根目录（默认 ./data）
VREADER_DATA_DIR=

# Gladia 云 ASR（主转写通道，免费 10h/月；空 = 只用本地 SenseVoice 兜底）
GLADIA_API_KEY=

# 提取 LLM 后端：openai（:8317 cliproxy）| agy（Antigravity CLI 主 + openai 兜底）| claude
# 生产用 agy：LLM_MODEL 走 agy（gemini-3.7-flash-medium，gold 97 格 100%），
# LLM_MODEL_FALLBACK 走 :8317（gemini-3.5-flash-lite）。
LLM_BACKEND=agy
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash-medium
LLM_MODEL_FALLBACK=gemini-3.5-flash-lite
LLM_TIMEOUT=600
# agy（Antigravity CLI）：生产机全路径 /Users/chivox/.local/bin/agy；
# 生产直连 antigravity 服务器不通，AGY_PROXY 配 HTTP 代理 URL（含口令，勿 commit）。
AGY_BIN=agy
AGY_PROXY=
